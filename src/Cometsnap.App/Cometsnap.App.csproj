<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cometsnap</AssemblyName>
    <RootNamespace>Cometsnap.App</RootNamespace>
    <StartupObject>Cometsnap.App.Program</StartupObject>
    <ApplicationIcon>..\..\assets\cometsnap.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <!-- The Windows 10 SDK projection gives access to Windows' built-in OCR (Windows.Media.Ocr). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Single-file Cometsnap.exe. CI passes -r win-x64 / win-arm64, and -p:CometsnapFlavor=Installed
       for the exe that goes into Cometsnap-Setup. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Installed (Cometsnap-Setup): framework-dependent, so the exe holds only Cometsnap itself.
       Setup installs Microsoft's .NET Desktop Runtime once when the PC does not have it. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(CometsnapFlavor)' == 'Installed'">
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Portable (default): carries its own .NET runtime, compressed inside the exe. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(CometsnapFlavor)' != 'Installed'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- The projection is big and only a few OCR calls use it: keep it as IL (smaller exe). -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="WinRT.Runtime.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cometsnap.Core\Cometsnap.Core.csproj" />
    <ProjectReference Include="..\Cometsnap.Editor\Cometsnap.Editor.csproj" />
    <ProjectReference Include="..\Cometsnap.Video\Cometsnap.Video.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\cometsnap.ico" Link="Assets\cometsnap.ico" />
    <Resource Include="..\..\assets\png\cometsnap-256.png" Link="Assets\cometsnap-256.png" />
    <Resource Include="..\..\assets\snap.wav" Link="Assets\snap.wav" />
    <Resource Include="..\..\assets\fonts\BungeeShade-Regular.ttf" Link="Assets\Fonts\BungeeShade-Regular.ttf" />
    <Resource Include="..\..\assets\fonts\Bungee-Regular.ttf" Link="Assets\Fonts\Bungee-Regular.ttf" />
  </ItemGroup>

</Project>
